# RN28: fuso de negócio (todas as datas são gravadas em UTC no banco)
APP_TIMEZONE=America/Campo_Grande

# ─── Banco de dados ──────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=estagia_cg_dev

# ─── Segurança / sessão ──────────────────────────────────────────────────
# RNF01: mínimo 12 (o PasswordHasher força de qualquer forma)
BCRYPT_COST=12
# RNF02: 30 min de ociosidade / 2 h de validade máxima
SESSION_IDLE_MS=1800000
SESSION_MAX_AGE_MS=28800000

# RN-A4: 5 falhas seguidas bloqueiam o login por 15 min
LOGIN_MAX_ATTEMPTS=5
LOGIN_BLOCK_MS=900000
TOUCH_THROTTLE_MS=60000

# ─── E-mail (task 05) ────────────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=2525
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=

# ─── Observabilidade (task 18) ───────────────────────────────────────────
SENTRY_DSN=

# ─── Script seed:admin ───────────────────────────────────────────────────
# Use somente em ambiente local/homologação.
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Tokens de uso único enviados por e-mail
# RN-A6: recuperação de senha e troca de e-mail valem 30 min
RECOVERY_TOKEN_TTL_MS=1800000
# RF22: convite de responsável vale 72 h
INVITE_TOKEN_TTL_MS=259200000
