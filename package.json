{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "estagia_cg",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only ./src/main.ts",
    "build": "tsc",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "test:watch": "vitest --watch",
    "db:up:test": "docker compose -f docker-compose.test.yml up -d",
    "db:down:test": "docker compose -f docker-compose.test.yml down -v",
    "seed:admin": "ts-node src/shared/database/seeds/create-first-admin.ts",
    "typeorm": "typeorm-ts-node-commonjs",
    "migration:generate": "npm run typeorm -- migration:generate src/shared/database/migrations/Init -d src/shared/database/data-source.ts",
    "migration:run": "npm run typeorm -- migration:run -d src/shared/database/data-source.ts",
    "migration:revert": "npm run typeorm -- migration:revert -d src/shared/database/data-source.ts",
    "schema:drop": "npm run typeorm -- schema:drop -d src/shared/database/data-source.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/multer": "^2.3.0",
    "@types/swagger-jsdoc": "^6.0.4",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "multer": "^2.4.0",
    "nodemailer": "^10.1.2",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1",
    "typeorm": "^1.1.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/dotenv": "^6.1.1",
    "@types/express": "^5.0.6",
    "@types/helmet": "^0.0.48",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.3",
    "@types/nodemailer": "^8.0.2",
    "@types/supertest": "^7.2.1",
    "@types/swagger-ui-express": "^4.1.8",
    "@vitest/ui": "^5.0.4",
    "cross-env": "^10.1.0",
    "dotenv-cli": "^11.0.0",
    "happy-dom": "^21.0.1",
    "jest": "^30.5.2",
    "supertest": "^7.3.1",
    "ts-jest": "^29.4.14",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  }
}
