import { Not, Repository } from "typeorm";
import { Responsible } from "../schema/Responsible.schema";
import { IResponsibleRepository } from "../interfaces/IResponsibleRepository";

export class ResponsibleRepository implements IResponsibleRepository {
  constructor(private repository: Repository<Responsible>) {}

  // RF01: o único lugar que devolve o hash, junto com o estado do bloqueio
  // (RN-A4). Só contas ATIVAS — conta desativada não entra.
  async findByEmailWithPassword(email: string): Promise<Responsible | null> {
    return await this.repository.findOne({
      where: { email, active: true },
      select: {
        id: true,
        email: true,
        passwordHash: true,
        active: true,
        failedLogins: true,
        blockedUntil: true,
      },
    });
  }

  async existsActiveById(id: string): Promise<boolean> {
    return await this.repository.exists({ where: { id, active: true } });
  }

  async findById(id: string): Promise<Responsible | null> {
    return await this.repository.findOne({ where: { id } });
  }

  // RN-A7: inclui desativados de propósito — o e-mail continua ocupado.
  async existsByEmail(email: string): Promise<boolean> {
    return await this.repository.exists({ where: { email } });
  }

  async isEmailTakenByOther(
    email: string,
    accountId: string,
  ): Promise<boolean> {
    return await this.repository.exists({
      where: { email, id: Not(accountId) },
    });
  }

  async recordLoginFailure(
    accountId: string,
    failedLogins: number,
    blockedUntil: Date | null,
  ): Promise<void> {
    await this.repository.update({ id: accountId }, { failedLogins, blockedUntil });
  }

  async clearLoginFailures(accountId: string): Promise<void> {
    await this.repository.update(
      { id: accountId },
      { failedLogins: 0, blockedUntil: null },
    );
  }

  async updatePassword(accountId: string, passwordHash: string): Promise<void> {
    await this.repository.update({ id: accountId }, { passwordHash });
  }

  async updateEmail(accountId: string, email: string): Promise<void> {
    await this.repository.update({ id: accountId }, { email });
  }
}
</file>

<file path="schema/Advertiser.schema.ts">
import { Column, Entity, PrimaryGeneratedColumn } from "typeorm";
import { AdvertiserType, VerificationStatus } from "../types/AdvertiserEnums";

// RF20: quem publica vagas. NÃO faz login — quem entra no sistema são os
// responsáveis (SRS 1.3). Por isso não há senha nem sessão aqui.
@Entity("advertisers")
export class Advertiser {
  @PrimaryGeneratedColumn("uuid")
  id: string;

  @Column({ name: "type", type: "enum", enum: AdvertiserType })
  type: AdvertiserType;

  // CNPJ (14) ou CPF (11), só dígitos. Único no banco: é o que impede a
  // mesma empresa de ter dois cadastros e burlar a vaga gratuita (RN-P1).
  @Column({ name: "cpnj", type: "varchar", length: 14, unique: true })
  cnpj: string;

  @Column({ name: "display_name", type: "varchar", length: 150 })
  displayName: string;

  // Só PJ tem razão social.
  @Column({ name: "legal_name", type: "varchar", length: 150, nullable: true })
  legalName: string | null;

  @Column({ name: "contact_email", type: "varchar", length: 255 })
  contactEmail: string;

  @Column({ name: "contact_phone", type: "varchar", length: 20 })
  contactPhone: string;

  @Column({ name: "site", type: "varchar", length: 255, nullable: true })
  site: string | null;

  @Column({
    name: "verification",
    type: "enum",
    enum: VerificationStatus,
    default: VerificationStatus.PENDING,
  })
  verification: VerificationStatus;

  // Quando o pedido de verificação foi feito. Não está no modelo da v4.9,
  // mas sem ele não dá para medir o tempo de fila — e o selo "Verificado"
  // só vale enquanto a fila anda. Ver RF21/RF30 (task 11).
  @Column({
    name: "verification_requested_at",
    type: "timestamptz",
    nullable: true,
  })
  verificationRequestedAt: Date | null;

  // RNF07: quem decidiu, quando e por qual método (RN-V2/V3).
  @Column({ name: "verified_by", type: "uuid", nullable: true })
  verifiedBy: string | null;

  @Column({ name: "verified_at", type: "timestamptz", nullable: true })
  verifiedAt: Date | null;

  @Column({
    name: "verification_method",
    type: "varchar",
    length: 150,
    nullable: true,
  })
  verificationMethod: string | null;

  @Column({ name: "rejection_reason", type: "text", nullable: true })
  rejectionReason: string | null;

  @Column({ name: "active", type: "boolean", default: true })
  active: boolean;

  @Column({ name: "created_at", type: "timestamptz", default: () => "now()" })
  createdAt: Date;
}
</file>

<file path="schema/Responsible.schema.ts">
import {
  Column,
  Entity,
  Index,
  JoinColumn,
  ManyToOne,
  PrimaryGeneratedColumn,
} from "typeorm";
import { Advertiser } from "./Advertiser.schema";

// RF20/RF22: pessoa que entra no sistema em nome de um anunciante. Um
// anunciante pode ter vários (dono e RH, por exemplo); cada responsável
// pertence a um único anunciante.
//
// É a TERCEIRA tabela de conta do projeto, ao lado de `students` e
// `admins` — decisão D1, registrada no TASKS.md: os perfis seguem
// separados, com o EmailRegistry garantindo e-mail único entre eles.
@Entity("responsibles")
@Index(["advertiserId"])
export class Responsible {
  @PrimaryGeneratedColumn("uuid")
  id: string;

  // RESTRICT e não CASCADE: anunciante com responsável não é apagado, é
  // desativado (RNF06).
  @ManyToOne(() => Advertiser, { nullable: false, onDelete: "RESTRICT" })
  @JoinColumn({ name: "advertiser_id" })
  advertiser: Advertiser;

  @Column({ name: "advertiser_id", type: "uuid" })
  advertiserId: string;

  @Column({ name: "name", type: "varchar", length: 150 })
  name: string;

  // RN-A7: único aqui e, via EmailRegistry, entre todos os perfis.
  @Column({ name: "email", type: "varchar", length: 255, unique: true })
  email: string;

  @Column({
    name: "password_hash",
    type: "varchar",
    length: 255,
    select: false,
  })
  passwordHash: string;

  @Column({ name: "active", type: "boolean", default: true })
  active: boolean;

  // RN-A4: mesmo bloqueio por tentativas dos outros perfis.
  @Column({ name: "failed_logins", type: "int", default: 0 })
  failedLogins: number;

  @Column({ name: "blocked_until", type: "timestamptz", nullable: true })
  blockedUntil: Date | null;

  @Column({ name: "created_at", type: "timestamptz", default: () => "now()" })
  createdAt: Date;
}
</file>

